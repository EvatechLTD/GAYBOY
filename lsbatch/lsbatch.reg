Windows Registry Editor Version 5.00

[-HKEY_CLASSES_ROOT\*\shell\LSBATCH]
[-HKEY_CLASSES_ROOT\SystemFileAssociations\.wav\shell\LSBATCH]

[HKEY_CLASSES_ROOT\SystemFileAssociations\.wav\shell\LSBATCH]
@="LSBATCH"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.wav\shell\LSBATCH\command]
@="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\Scripts\\lsbatch.ps1\" \"%1\""